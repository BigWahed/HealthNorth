{% extends 'base.html.twig' %}

{% block title %}Mes patients - Health NORTH{% endblock %}

{% block body %}
<section class="hn-section-gap">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-2">Mes patients</h1>
            <p class="text-secondary mb-0">Liste des utilisateurs ayant le rôle patient.</p>
        </div>
        <a href="{{ path('pro_dashboard') }}" class="btn btn-outline-secondary">Retour à mon espace</a>
    </div>

    <div class="hn-card p-4">
        {% if patients is empty %}
            <p class="text-secondary mb-0">Aucun patient trouvé.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for patient in patients %}
                        <tr>
                            <td>{{ patient.nom }}</td>
                            <td>{{ patient.prenom }}</td>
                            <td>{{ patient.email }}</td>
                            <td>{{ patient.telephone }}</td>
                            <td class="text-end">
                                <a href="{{ path('pro_patient_show', {id: patient.id}) }}" class="btn btn-outline-primary btn-sm">Voir dossier</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}


