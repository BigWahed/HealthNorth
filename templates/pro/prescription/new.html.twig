{% extends 'base.html.twig' %}

{% block title %}Ajouter une prescription - Health NORTH{% endblock %}

{% block body %}
<section class="hn-section-gap">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-2">Ajouter une prescription</h1>
            {% if patient %}
                <p class="text-secondary mb-0">Patient sélectionné : {{ patient.prenom }} {{ patient.nom }}</p>
            {% else %}
                <p class="text-secondary mb-0">Créer une prescription pour un patient.</p>
            {% endif %}
        </div>
        <div class="d-flex flex-wrap gap-2">
            {% if patient %}
                <a href="{{ path('pro_patient_show', {id: patient.id}) }}" class="btn btn-outline-primary">Retour dossier patient</a>
            {% endif %}
            <a href="{{ path('pro_dashboard') }}" class="btn btn-outline-secondary">Retour dashboard</a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="hn-card p-4 p-md-5">
                {{ form_start(form) }}
                    <div class="row g-4">
                        {% if form.patient is defined %}
                            <div class="col-12">
                                {{ form_row(form.patient) }}
                            </div>
                        {% endif %}

                        <div class="col-12">
                            {{ form_row(form.contenu) }}
                        </div>

                        <div class="col-12 col-md-6">
                            {{ form_row(form.datePrescription) }}
                        </div>
                    </div>

                    <div class="mt-4 d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">Enregistrer la prescription</button>
                        {% if patient %}
                            <a href="{{ path('pro_patient_show', {id: patient.id}) }}" class="btn btn-outline-primary">Retour dossier patient</a>
                        {% else %}
                            <a href="{{ path('pro_patients') }}" class="btn btn-outline-primary">Voir les patients</a>
                        {% endif %}
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
