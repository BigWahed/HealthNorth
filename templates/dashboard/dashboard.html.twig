{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} - Health NORTH{% endblock %}

{% block body %}
<section class="hn-section-gap">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-2">{{ page_title }}</h1>
            <p class="text-secondary mb-0">{{ page_subtitle }}</p>
        </div>
        <span class="badge hn-badge px-3 py-2">{{ role_label }}</span>
    </div>

    <div class="row g-4">
        {% for card in cards %}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="hn-card h-100 p-4">
                    <h2 class="h6 mb-3">{{ card.title }}</h2>
                    <p class="text-secondary mb-4">{{ card.text }}</p>
                    <a href="{{ card.link|default('#') }}" class="btn btn-outline-primary btn-sm">{{ card.action }}</a>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}
