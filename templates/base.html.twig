<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Health NORTH{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --hn-bg: #f4f7fb;
            --hn-card: #ffffff;
            --hn-border: #dce6f2;
            --hn-text: #1e2a3a;
            --hn-primary: #1d6fd6;
            --hn-primary-soft: #e8f1fd;
        }

        body {
            background-color: var(--hn-bg);
            color: var(--hn-text);
        }

        .hn-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--hn-border);
        }

        .hn-brand-logo {
            height: 60px;
            width: auto;
            display: block;
        }

        .hn-brand-link {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
        }

        .hn-brand-separator {
            width: 1px;
            height: 36px;
            background: #d6e3f4;
        }

        .hn-brand-text {
            font-weight: 800;
            font-size: 1.55rem;
            color: #0b2b4d;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .hn-brand-north {
            color: #2ea8ff;
        }

        .hn-card {
            border: 1px solid var(--hn-border);
            border-radius: 14px;
            background: var(--hn-card);
        }

        .hn-section-gap {
            margin-top: 2rem;
            margin-bottom: 2rem;
        }

        .hn-badge {
            background: var(--hn-primary-soft);
            color: var(--hn-primary);
            border: 1px solid #cfe0f7;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg hn-navbar">
    <div class="container py-2">
        <a href="{{ path('app_home') }}" class="navbar-brand mb-0 hn-brand-link" aria-label="Accueil Health NORTH">
            <img src="/images/logo/logohealthnorth.png" alt="Logo Health NORTH" class="hn-brand-logo">
            <span class="hn-brand-separator" aria-hidden="true"></span>
            <span class="hn-brand-text">
                Health <span class="hn-brand-north">NORTH</span>
            </span>
        </a>
        <div class="ms-auto d-flex gap-2">
            {% block nav_actions %}
                {% if app.user %}
                    <span class="badge hn-badge align-self-center">{{ app.user.userIdentifier }}</span>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary btn-sm">Se déconnecter</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm">Connexion</a>
                {% endif %}
            {% endblock %}
        </div>
    </div>
</nav>

<main class="container py-4 py-md-5">
    {% block body %}{% endblock %}
</main>

{% block javascripts %}{% endblock %}
</body>
</html>

