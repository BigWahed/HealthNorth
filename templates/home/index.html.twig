{% extends 'base.html.twig' %}

{% block title %}Accueil - Health NORTH{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .hn-hero-image {
            width: 100%;
            height: 320px;
            object-fit: cover;
            border-radius: 14px;
            border: 1px solid var(--hn-border);
            background: #fff;
        }

        .hn-home-brand-title {
            font-weight: 800;
            font-size: clamp(2.2rem, 5vw, 3.2rem);
            color: #0b2b4d;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            line-height: 1.05;
            margin-bottom: 1rem;
        }

        .hn-home-brand-north {
            color: #2ea8ff;
        }

        .hn-feature-icon {
            width: 74px;
            height: 74px;
            border-radius: 50%;
            background: #e8f1fd;
            color: #1d6fd6;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .hn-stat-value {
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 800;
            color: #0b2b4d;
            line-height: 1;
        }

        .feature-icon {
            width: 78px;
            height: 78px;
            border-radius: 16px;
            background: linear-gradient(180deg, #2f8fff 0%, #1d6fd6 100%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.1rem;
            box-shadow: 0 8px 20px rgba(25, 112, 214, 0.22);
        }

        .feature-icon svg {
            width: 36px;
            height: 36px;
            color: #ffffff;
        }
    </style>
{% endblock %}

{% block nav_actions %}
    {% if app.user and dashboard_route %}
        <a href="{{ path('app_home') }}" class="btn btn-outline-primary btn-sm">Accueil</a>
        <a href="{{ path(dashboard_route) }}" class="btn btn-primary btn-sm">Mon dashboard</a>
        <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary btn-sm">Déconnexion</a>
    {% else %}
        <a href="{{ path('app_home') }}" class="btn btn-outline-primary btn-sm">Accueil</a>
        <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm">Connexion</a>
        <a href="{{ path('app_register') }}" class="btn btn-outline-secondary btn-sm">Créer un compte</a>
    {% endif %}
{% endblock %}

{% block body %}
<section class="hn-section-gap">
    <div class="row align-items-center g-4">
        <div class="col-12 col-lg-7">
            <h1 class="hn-home-brand-title">
                Health <span class="hn-home-brand-north">NORTH</span>
            </h1>
            <p class="lead text-secondary mb-4">
                Une plateforme santé claire et sécurisée pour accompagner les patients et les professionnels au quotidien.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">Se connecter</a>
                <a href="{{ path('app_register') }}" class="btn btn-outline-secondary btn-lg">Créer un compte patient</a>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <img
                src="https://images.unsplash.com/photo-1584982751601-97dcc096659c?auto=format&fit=crop&w=1200&q=80"
                alt="Professionnelle de santé en consultation"
                class="hn-hero-image"
            >
        </div>
    </div>
</section>

<section class="hn-section-gap">
    <div class="hn-card p-4 p-md-5">
        <h2 class="h4 mb-3">Présentation</h2>
        <p class="text-secondary mb-3">
            Health NORTH est un groupe européen fictif spécialisé dans les services de santé. Le groupe couvre les
            laboratoires d’analyses, l’imagerie médicale, les cliniques et l’hospitalisation, avec un objectif simple:
            offrir un parcours patient plus fluide, plus lisible et mieux suivi.
        </p>
        <p class="text-secondary mb-0">
            La plateforme accompagne les patients au quotidien et aide les professionnels à organiser les rendez-vous,
            les prescriptions, les résultats médicaux et le suivi des traitements.
        </p>
    </div>
</section>

<section class="hn-section-gap">
    <h2 class="h4 text-center mb-4">Votre compagnon de santé au quotidien</h2>
    <div class="row g-4 text-center">
        <div class="col-12 col-md-4">
            <div class="hn-card h-100 p-4">
                <div class="hn-feature-icon">📅</div>
                <h3 class="h5">Accédez aux soins plus facilement</h3>
                <p class="text-secondary mb-0">
                    Prenez rendez-vous rapidement et suivez vos prochaines consultations depuis un espace unique.
                </p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="hn-card h-100 p-4">
                <div class="hn-feature-icon">🩺</div>
                <h3 class="h5">Bénéficiez d’un suivi personnalisé</h3>
                <p class="text-secondary mb-0">
                    Consultez votre dossier patient, vos prescriptions et vos résultats d’analyse en toute simplicité.
                </p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="hn-card h-100 p-4">
                <div class="hn-feature-icon">🔒</div>
                <h3 class="h5">Gérez vos données en sécurité</h3>
                <p class="text-secondary mb-0">
                    Les accès sont protégés par authentification, avec des espaces dédiés patient, professionnel et admin.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="hn-section-gap">
    <div class="hn-card p-4 p-md-5">
        <h2 class="h3 mb-4">Health NORTH en chiffres</h2>
        <div class="row g-4">
            <div class="col-12 col-md-6 col-xl-3">
                <div class="hn-stat-value">12 000</div>
                <p class="text-secondary mb-0">employés</p>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <div class="hn-stat-value">5 000</div>
                <p class="text-secondary mb-0">médecins</p>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <div class="hn-stat-value">300</div>
                <p class="text-secondary mb-0">cliniques</p>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <div class="hn-stat-value">1 200</div>
                <p class="text-secondary mb-0">centres d’imagerie</p>
            </div>
        </div>
        <p class="text-secondary mt-4 mb-0">
            Plus de 8 millions d’analyses sont réalisées chaque année dans le réseau Health NORTH.
        </p>
    </div>
</section>

<section class="hn-section-gap">
    <div class="container px-4 py-5" id="featured-3">
        <h2 class="pb-2 border-bottom">Services disponibles</h2>
        <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
            <div class="feature col">
                <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h.5A1.5 1.5 0 0 1 15 2.5v11A1.5 1.5 0 0 1 13.5 15h-11A1.5 1.5 0 0 1 1 13.5v-11A1.5 1.5 0 0 1 2.5 1H3V.5a.5.5 0 0 1 .5-.5M2 6v7.5a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5V6z"/>
                    </svg>
                </div>
                <h3 class="fs-3 text-body-emphasis">Prise de rendez-vous</h3>
                <p>Planifiez rapidement une consultation, une analyse ou une intervention.</p>
                <a href="#prise-rdv" class="icon-link">En savoir plus</a>
            </div>
            <div class="feature col">
                <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zM13 2H8.5a1 1 0 0 0-1 1V3a1 1 0 0 0 1 1H13z"/>
                        <path d="M8 6.5a.5.5 0 0 1 .5.5V8H10a.5.5 0 0 1 0 1H8.5v1.5a.5.5 0 0 1-1 0V9H6a.5.5 0 0 1 0-1h1.5V7a.5.5 0 0 1 .5-.5"/>
                    </svg>
                </div>
                <h3 class="fs-3 text-body-emphasis">Dossier patient</h3>
                <p>Retrouvez les informations médicales importantes dans un espace unique.</p>
                <a href="#dossier-patient" class="icon-link">En savoir plus</a>
            </div>
            <div class="feature col">
                <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4 1h8a2 2 0 0 1 2 2v10.5a.5.5 0 0 1-.8.4L11.5 12l-1.7 1.9a.5.5 0 0 1-.8 0L7.3 12l-1.7 1.9a.5.5 0 0 1-.8-.4V3a2 2 0 0 1 2-2m2 3a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1zm0 2.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1z"/>
                    </svg>
                </div>
                <h3 class="fs-3 text-body-emphasis">Prescriptions</h3>
                <p>Consultez vos ordonnances et le détail des traitements prescrits.</p>
                <a href="#prescriptions" class="icon-link">En savoir plus</a>
            </div>
            <div class="feature col">
                <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M0 0h1v15h15v1H0z"/>
                        <path d="M10 10.5a.5.5 0 0 1-.5-.5V6.707L8.354 7.854a.5.5 0 1 1-.708-.708l2-2A.5.5 0 0 1 10.5 5v5a.5.5 0 0 1-.5.5"/>
                        <path d="M6 12a.5.5 0 0 1-.5-.5V8.707L4.354 9.854a.5.5 0 1 1-.708-.708l2-2A.5.5 0 0 1 6.5 7v4.5a.5.5 0 0 1-.5.5M13 9.5a.5.5 0 0 1-.5-.5V4.707l-1.146 1.147a.5.5 0 0 1-.708-.708l2-2A.5.5 0 0 1 13.5 3V9a.5.5 0 0 1-.5.5"/>
                    </svg>
                </div>
                <h3 class="fs-3 text-body-emphasis">Résultats d’analyse</h3>
                <p>Visualisez les résultats de laboratoire et d’imagerie médicale.</p>
                <a href="#resultats" class="icon-link">En savoir plus</a>
            </div>
            <div class="feature col">
                <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8.5 1.5a1.5 1.5 0 0 1 0 3H7a1.5 1.5 0 0 1 0-3z"/>
                        <path d="M3.5 8a2.5 2.5 0 0 1 2.5-2.5h2a2.5 2.5 0 0 1 0 5h-2A2.5 2.5 0 0 1 3.5 8m6 0a2.5 2.5 0 0 1 2.5-2.5h.5a2.5 2.5 0 0 1 0 5H12A2.5 2.5 0 0 1 9.5 8"/>
                    </svg>
                </div>
                <h3 class="fs-3 text-body-emphasis">Suivi des médicaments</h3>
                <p>Suivez les prises, les fréquences et la continuité des traitements.</p>
                <a href="#medicaments" class="icon-link">En savoir plus</a>
            </div>
        </div>
    </div>
</section>

<section class="hn-section-gap">
    <div class="hn-card p-4 p-md-5">
        <h2 class="h4 mb-4">Détail des services</h2>

        <div class="row g-4">
            <div class="col-12" id="prise-rdv">
                <div class="p-3 border rounded-3 bg-white">
                    <h3 class="h5 mb-2">Prise de rendez-vous</h3>
                    <p class="text-secondary mb-3">
                        La prise de rendez-vous permet aux patients de sélectionner un établissement, un type d’intervention, un professionnel de santé ainsi qu’une date. Une fois validé, le rendez-vous est automatiquement rattaché au compte patient connecté et peut être consulté depuis l’espace personnel.
                    </p>
                    <a href="/patient/rendez-vous/nouveau" class="btn btn-primary btn-sm">Prendre rendez-vous</a>
                </div>
            </div>

            <div class="col-12" id="dossier-patient">
                <div class="p-3 border rounded-3 bg-white">
                    <h3 class="h5 mb-2">Dossier patient</h3>
                    <p class="text-secondary mb-3">
                        Le dossier patient regroupe les informations essentielles liées au suivi médical : informations personnelles, rendez-vous, prescriptions, résultats d’analyse et prises de médicaments. Chaque patient accède uniquement à ses propres données après authentification.
                    </p>
                    <a href="/patient/dossier" class="btn btn-primary btn-sm">Accéder à mon dossier</a>
                </div>
            </div>

            <div class="col-12" id="prescriptions">
                <div class="p-3 border rounded-3 bg-white">
                    <h3 class="h5 mb-2">Prescriptions</h3>
                    <p class="text-secondary mb-3">
                        Les prescriptions sont ajoutées par les professionnels de santé depuis leur espace sécurisé. Le patient peut ensuite les consulter dans son espace personnel afin de retrouver les indications transmises par le professionnel.
                    </p>
                    <a href="/patient/prescriptions" class="btn btn-primary btn-sm">Voir mes prescriptions</a>
                </div>
            </div>

            <div class="col-12" id="resultats">
                <div class="p-3 border rounded-3 bg-white">
                    <h3 class="h5 mb-2">Résultats d’analyse</h3>
                    <p class="text-secondary mb-3">
                        Les résultats d’analyse permettent au patient de consulter les informations liées aux examens réalisés, comme le type d’analyse, la date, le statut et le commentaire associé. Ces données sont accessibles uniquement après connexion.
                    </p>
                    <a href="/patient/resultats" class="btn btn-primary btn-sm">Voir mes résultats</a>
                </div>
            </div>

            <div class="col-12" id="medicaments">
                <div class="p-3 border rounded-3 bg-white">
                    <h3 class="h5 mb-2">Suivi des médicaments</h3>
                    <p class="text-secondary mb-3">
                        Le suivi des médicaments permet au patient de visualiser l’ordonnancement de ses prises : médicament, posologie, fréquence et moment de prise. Cette fonctionnalité facilite le suivi des traitements prescrits.
                    </p>
                    <a href="/patient/prises-medicaments" class="btn btn-primary btn-sm">Voir mes prises</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="hn-section-gap">
    <div class="hn-card p-4 p-md-5">
        <h2 class="h4 mb-3">Accès sécurisé</h2>
        <div class="row g-3 text-secondary">
            <div class="col-12 col-md-6">
                <p class="mb-1"><strong class="text-dark">Espace patient :</strong> suivi personnel et consultation des données de santé.</p>
            </div>
            <div class="col-12 col-md-6">
                <p class="mb-1"><strong class="text-dark">Espace professionnel :</strong> gestion des rendez-vous, dossiers et prescriptions.</p>
            </div>
            <div class="col-12 col-md-6">
                <p class="mb-1"><strong class="text-dark">Espace administrateur :</strong> administration des données principales.</p>
            </div>
            <div class="col-12 col-md-6">
                <p class="mb-1"><strong class="text-dark">Protection des données :</strong> accès contrôlé par authentification et rôles.</p>
            </div>
        </div>
    </div>
</section>

<footer class="text-center text-secondary small py-3">
    Health NORTH - Plateforme fictive pédagogique BTS SIO SLAM.
</footer>
{% endblock %}
