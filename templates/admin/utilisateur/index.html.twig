{% extends 'base.html.twig' %}

{% block title %}Utilisateurs - Health NORTH{% endblock %}

{% block body %}
<section class="hn-section-gap">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-2">Utilisateurs</h1>
            <p class="text-secondary mb-0">Consultation simple des comptes existants.</p>
        </div>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">Retour dashboard</a>
    </div>

    <div class="hn-card p-4">
        {% if utilisateurs is empty %}
            <p class="text-secondary mb-0">Aucun utilisateur.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Nom</th><th>Prénom</th><th>Email</th><th>Rôles</th><th>Téléphone</th></tr></thead>
                    <tbody>
                    {% for utilisateur in utilisateurs %}
                        <tr>
                            <td>{{ utilisateur.nom }}</td>
                            <td>{{ utilisateur.prenom }}</td>
                            <td>{{ utilisateur.email }}</td>
                            <td>{{ utilisateur.roles|join(', ') }}</td>
                            <td>{{ utilisateur.telephone }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
