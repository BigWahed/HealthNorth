{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} - Health NORTH{% endblock %}

{% block body %}
<section class="hn-section-gap">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 mb-0">{{ page_title }}</h1>
        <a href="{{ path(back_route) }}" class="btn btn-outline-secondary">Retour liste</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="hn-card p-4 p-md-5">
                {{ form_start(form) }}
                    <div class="row g-3">
                        <div class="col-12">{{ form_row(form.nom) }}</div>
                        <div class="col-12 col-md-6">{{ form_row(form.type) }}</div>
                        <div class="col-12 col-md-6">{{ form_row(form.codePostal) }}</div>
                        <div class="col-12">{{ form_row(form.adresse) }}</div>
                        <div class="col-12 col-md-6">{{ form_row(form.ville) }}</div>
                    </div>
                    <div class="mt-4 d-flex flex-wrap gap-2">
                        <button class="btn btn-primary">Enregistrer</button>
                        <a href="{{ path(back_route) }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
