{% extends 'base.html.twig' %}

{% block title %}Mes prises de médicaments - Health NORTH{% endblock %}

{% block body %}
<section class="hn-section-gap">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-2">Mes prises de médicaments</h1>
            <p class="text-secondary mb-0">Liste des prises associées à ton compte patient.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('patient_dossier') }}" class="btn btn-outline-primary">Mon dossier patient</a>
            <a href="{{ path('patient_dashboard') }}" class="btn btn-outline-secondary">Retour dashboard</a>
        </div>
    </div>

    <div class="hn-card p-4">
        {% if prisesMedicaments is empty %}
            <p class="text-secondary mb-0">Aucune prise de médicament pour le moment.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Médicament</th>
                        <th>Posologie</th>
                        <th>Fréquence</th>
                        <th>Moment de prise</th>
                        <th>Prescription associée</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for prise in prisesMedicaments %}
                        <tr>
                            <td>{{ prise.medicament ? prise.medicament.nom : '-' }}</td>
                            <td>{{ prise.posologie }}</td>
                            <td>{{ prise.frequence }}</td>
                            <td>{{ prise.momentPrise }}</td>
                            <td>
                                {% if prise.prescription and prise.prescription.datePrescription %}
                                    Prescription du {{ prise.prescription.datePrescription|date('d/m/Y') }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
