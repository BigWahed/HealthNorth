{% extends 'base.html.twig' %}

{% block title %}Connexion - Health NORTH{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="hn-card shadow-sm p-4 p-md-5">
            <h1 class="h4 mb-4 text-center">Connexion</h1>

            {% if error %}
                <div class="alert alert-danger">Email ou mot de passe invalide.</div>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            {% if app.user %}
                <div class="alert alert-info">
                    Tu es connecté avec {{ app.user.userIdentifier }}.
                    <a href="{{ path('app_logout') }}" class="alert-link">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="post" class="mt-2">
                <div class="mb-3">
                    <label for="username" class="form-label">Email</label>
                    <input type="email" id="username" name="_username" class="form-control form-control-lg" value="{{ last_username }}" required autofocus>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">Mot de passe</label>
                    <input type="password" id="password" name="_password" class="form-control form-control-lg" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary w-100 btn-lg" type="submit">Connexion</button>
            </form>

            <div class="mt-4 d-flex justify-content-center">
                <a href="{{ path('app_register') }}" class="btn btn-outline-primary btn-sm">Créer un compte patient</a>
            </div>

        </div>
    </div>
</div>
{% endblock %}

